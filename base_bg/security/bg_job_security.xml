<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_bg_job_manager" model="res.groups">
        <field name="name">Background Jobs: Manager</field>
    </record>
    <record id="bg_job_rule_own" model="ir.rule">
        <field name="name">Background jobs: own jobs</field>
        <field name="model_id" ref="model_bg_job"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="bg_job_rule_manager" model="ir.rule">
        <field name="name">Background jobs: all jobs (managers, administrators)</field>
        <field name="model_id" ref="model_bg_job"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_bg_job_manager')), Command.link(ref('base.group_system'))]"/>
    </record>
</odoo>
